{
  "$description": "Proyecto PasiTOs · tokens de diseño web v1.0 (30-09-2026). Formato W3C Design Tokens. Contraste AA 4,5:1 para todo texto; ver identidad-visual.md.",
  "color": {
    "marca": {
      "azul-petroleo": {
        "$type": "color",
        "$value": "#0C4759",
        "$description": "Principal: titulares, texto sobre claro, fondos de impacto, botón principal"
      },
      "azul-medio": {
        "$type": "color",
        "$value": "#1B7796",
        "$description": "Enlaces, palabra destacada sobre claro, botón secundario con texto blanco"
      },
      "azul-cielo": {
        "$type": "color",
        "$value": "#00B0EA",
        "$description": "Solo gráfico (huellas, iconos, detalles). Nunca texto ni fondo con texto"
      },
      "fondo-claro": {
        "$type": "color",
        "$value": "#F1FAFD",
        "$description": "Fondo de secciones alternas"
      },
      "blanco": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Fondo principal y texto sobre azul petróleo o azul medio"
      }
    },
    "apoyo": {
      "gris-azulado": {
        "$type": "color",
        "$value": "#4A6E7B",
        "$description": "Texto secundario sobre claro"
      },
      "bruma": {
        "$type": "color",
        "$value": "#EAF6FA",
        "$description": "Fondo de tarjetas"
      },
      "cielo-claro": {
        "$type": "color",
        "$value": "#7FD8F7",
        "$description": "Destacados y enlaces sobre azul petróleo"
      },
      "gris-sobre-oscuro": {
        "$type": "color",
        "$value": "#AECBD6",
        "$description": "Texto secundario sobre azul petróleo"
      }
    },
    "externo": {
      "whatsapp": {
        "$type": "color",
        "$value": "#25D366",
        "$description": "Solo botón de WhatsApp"
      },
      "whatsapp-texto": {
        "$type": "color",
        "$value": "#0B2E1A",
        "$description": "Texto del botón de WhatsApp (7,46:1)"
      }
    },
    "logo-solo": {
      "azul-to": {
        "$type": "color",
        "$value": "#00A2DB",
        "$description": "Solo dentro del logotipo (el 'TO'). No usar en web"
      }
    },
    "opcional": {
      "sol": {
        "$type": "color",
        "$value": "#FFC845",
        "$description": "Opción B no recomendada: acento cálido para CTA, con texto azul petróleo (6,60:1)"
      }
    }
  },
  "semantico": {
